# Salin menjadi .env.production.local di root project, lalu isi nilainya.
# File .env.production.local tidak boleh di-commit.

# Supabase Cloud (browser-safe values only)
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

# Google AdSense publisher ID, contoh: ca-pub-1234567890123456
# Kosongkan jika AdSense belum aktif.
VITE_ADSENSE_CLIENT=

# AdMob (khusus aplikasi Android/Capacitor).
# Wajib false untuk build production.
VITE_ADMOB_TEST_MODE=false
VITE_ADMOB_NATIVE_ENABLED=true

# Cloudflare Turnstile site key (opsional).
# Harus dipasangkan dengan secret Edge Function TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Jangan pernah menaruh service role key di variabel VITE_*.
