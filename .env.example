# Supabase (browser-safe values only)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-hosted-anon-key

# Koneksi Postgres untuk CLI dan migrasi. Bukan VITE_*, jangan dipakai di browser.
# Pakai session pooler (port 5432): host db.<ref>.supabase.co hanya IPv6 dan sering gagal
# dari jaringan tanpa IPv6. Simpan nilai asli di .env.db.local (diabaikan git).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Google AdSense publisher ID, contoh: ca-pub-1234567890123456
# Kosongkan jika AdSense belum aktif.
VITE_ADSENSE_CLIENT=

# AdMob (khusus aplikasi Android/Capacitor).
# Set true saat membuat APK uji agar selalu memakai unit iklan demo Google.
# Jangan pernah mengaktifkan ini pada build production.
VITE_ADMOB_TEST_MODE=false
# Set false untuk mematikan native advanced jika overlay bermasalah di perangkat.
VITE_ADMOB_NATIVE_ENABLED=true

# Cloudflare Turnstile site key (opsional).
# Harus dipasangkan dengan secret Edge Function TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Jangan pernah menaruh service role key di variabel VITE_*.
# Untuk skrip admin lokal, gunakan file .env.admin.local yang diabaikan git.
#
# Secret Edge Function (bukan VITE_*):
#   supabase secrets set TURNSTILE_SECRET_KEY=... RATE_LIMIT_SALT=...
# Tanpa TURNSTILE_SECRET_KEY, formulir publik tetap dilindungi rate limit + honeypot.
