# Supabase (browser-safe values only)
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-hosted-anon-key

# Google AdSense publisher ID, contoh: ca-pub-1234567890123456
# Kosongkan jika AdSense belum aktif.
VITE_ADSENSE_CLIENT=

# Cloudflare Turnstile site key (opsional).
# Harus dipasangkan dengan secret Edge Function TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Jangan pernah menaruh service role key di variabel VITE_*.
# Untuk skrip admin lokal, gunakan file .env.admin.local yang diabaikan git.
#
# Secret Edge Function (bukan VITE_*):
#   supabase secrets set TURNSTILE_SECRET_KEY=... RATE_LIMIT_SALT=...
# Tanpa TURNSTILE_SECRET_KEY, formulir publik tetap dilindungi rate limit + honeypot.
